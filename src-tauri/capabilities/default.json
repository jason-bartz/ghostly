{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Capabilities for the app",
  "windows": ["main", "recording_overlay", "meeting_panel"],
  "permissions": [
    "core:default",
    "core:window:allow-start-dragging",
    "opener:default",
    "deep-link:default",
    "store:default",
    "dialog:default",
    "updater:default",
    "process:default",
    "global-shortcut:allow-is-registered",
    "global-shortcut:allow-register",
    "global-shortcut:allow-unregister",
    "global-shortcut:allow-unregister-all",
    "macos-permissions:default",
    "notification:default",
    "fs:read-files",
    "fs:allow-resource-read-recursive",
    {
      "comment": "Deep links into the System Settings privacy panes. macOS only prompts for a permission once, so a denied microphone can be fixed nowhere else — and the opener default scope covers http/mailto/tel only.",
      "identifier": "opener:allow-open-url",
      "allow": [{ "url": "x-apple.systempreferences:*" }]
    },
    {
      "identifier": "fs:scope",
      "allow": [{ "path": "$APPDATA" }, { "path": "$APPDATA/**/*" }]
    }
  ]
}
